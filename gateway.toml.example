# Copy this file to gateway.toml and edit as needed.
# Provider keys can be set as environment variables or added from the dashboard.

# Built-in providers and their API-key environment variables:
# openai       = OPENAI_API_KEY
# anthropic    = ANTHROPIC_API_KEY
# ollama       = (none)
# groq         = GROQ_API_KEY
# vllm         = VLLM_API_KEY
# lite_llm     = LITELLM_API_KEY
# openrouter   = OPENROUTER_API_KEY
# deepseek     = DEEPSEEK_API_KEY
# gemini       = GEMINI_API_KEY
# mistral      = MISTRAL_API_KEY
# kimi         = MOONSHOT_API_KEY
# zai          = ZAI_API_KEY
# opencode_*   = OPENCODE_API_KEY
# commandcode  = COMMANDCODE_API_KEY
# chatgpt      = (no API key — ChatGPT Plus/Pro device sign-in, see README)

# The gateway only listens on addresses listed in listen_addrs.
# ChatGPT OAuth uses device-code sign-in and does not require a callback port.
listen_addrs = ["127.0.0.1:8787"]
store = "gateway.db"
# Remove chat payloads after 7 days; keep usage statistics.
retention_days = 7

[settings]
default_alias = "mistral"
request_plugins = []
response_plugins = []
log_payloads = false

[providers.mistral]
base_url = "https://api.mistral.ai/v1"
api_key_env = "MISTRAL_API_KEY"
models = ["mistral-large-latest", "mistral-small-latest"]

# Provider templates are built in. Define a [providers.<name>] section only
# when you want to override a provider's defaults.
[[instances]]
alias = "mistral"
template = "mistral"
