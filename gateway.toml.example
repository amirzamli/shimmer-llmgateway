# Shimmer LLM Gateway configuration.
#
# Copy this file to gateway.toml and edit it. API keys never live here — they
# come from the api_key_env environment variable or the UI-managed secrets file
# (<store>.secrets.json, encrypted at rest).

# Each address is bound to its own socket, so the gateway can serve localhost
# and a Tailscale address side by side. Allowed hosts: loopback (127.0.0.0/8,
# ::1, localhost), CGNAT (100.64.0.0/10 — the Tailscale default range), and
# ULA (fc00::/7). A wildcard (0.0.0.0) is refused; a plain RFC 1918 LAN
# address (192.168.x.x) is refused too — it would expose the unauthenticated
# API to every host on the local network. `listen` (a single address) is still
# accepted for backwards compatibility; set one or the other, not both.
listen_addrs = ["127.0.0.1:8787", "100.64.0.1:8787"]
store  = "gateway.db"
# Payload retention: after this many days a session's chat payloads are
# removed and only usage statistics remain. Default when unset is 7;
# <= 0 disables purging entirely.
retention_days = 7

[settings]
default_alias = "openai"        # used when a client sends no alias prefix
request_plugins = []            # global defaults, overridable per instance
response_plugins = []
log_payloads = false            # opt-in: log redacted payloads to the console
# Dashboard color scheme remembered by the header theme toggle ("dark"/"light");
# written back when you toggle. Unset = dark.
# ui_theme = "dark"

[providers.openai]              # TEMPLATE: the dropdown entry
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"  # default for the first instance
models = ["gpt-4o", "gpt-4o-mini"]
# Optional per-model advertised reasoning levels (model_reasoning_options):
# gates instance `model_reasoning` values and drives the UI dropdown. Built-ins
# seed this where known (e.g. deepseek-v4-flash: low/high/max); models without
# metadata accept default/none/minimal/low/medium/high/xhigh/max.
# model_reasoning_options = { "gpt-4o" = ["low", "medium", "high"] }

[providers.ollama]              # keyless local provider
base_url = "http://localhost:11434/v1"
api_key_env = ""
models = ["llama3.1"]

# Template-level `plugins` (optional) is a materialization seed only: when an
# instance of this template has no `plugins` of its own, a write-back records
# a copy of this list as the instance's `plugins` line, so the file states the
# default explicitly. It is never consulted at runtime — an instance with no
# `plugins` line resolves from the global settings (empty by default = OFF).
[providers.openrouter]           # OpenRouter reasoning models (e.g. stealth/ox-alpha)
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"
models = ["openrouter/auto"]

# [providers.opencode_go] mirrors the built-in template: Console Go's deepseek
# thinking models, plus the session_header the upstream requires — the gateway
# synthesises the request's session id into x-opencode-session on every call
# (without it Console Go answers HTTP 400 MissingSessionID).
[providers.opencode_go]
base_url = "https://opencode.ai/zen/go/v1"
api_key_env = "OPENCODE_API_KEY"
models = ["deepseek-v4-flash", "deepseek-v4-pro"]
session_header = "x-opencode-session"
# fill_reasoning_content (request-side) prevents Console Go's thinking-mode
# 400: "The `reasoning_content` in the thinking mode must be passed back to
# the API." deepseek thinking models on this endpoint require every assistant
# message with tool_calls to carry reasoning_content once the conversation has
# reasoned; agent clients occasionally replay a pure tool-call turn without
# it, and the upstream rejects the request. The plugin backfills an empty
# reasoning_content on assistant messages that lack it (empty is accepted).
plugins = ["fill_reasoning_content"]

[[instances]]                   # INSTANCE 1 of openai — alias defaults to "openai"
alias = "openai"
template = "openai"
api_key_env = "OPENAI_API_KEY"
# priority = 1                  # lower = higher routing priority for unprefixed
                                # model names (e.g. "small"); unset = file order
